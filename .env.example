NODE_ENV=development
PORT=3001

# PostgreSQL — use DATABASE_URL or discrete vars (alternatif: DATABASE_HOST, DATABASE_PORT, …)
DATABASE_URL=postgresql://app:app@localhost:5432/myapp
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myapp
DB_USER=app
DB_PASSWORD=app

# Create/update tables from entities (dev only; use migrations in production)
DB_SYNC=true

# Connection pool size and how long a request waits for a free connection
# before failing fast (ms). pg's own defaults are max=10, timeout=0 (wait
# forever) — both overridden here on purpose.
DB_POOL_MAX=20
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# Redis cache (optional)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=flag-api:

# Required. `FlagsSdkController` and `FlagsAdminController` require
# `Authorization: Bearer <FLAGS_API_KEY>`. The process refuses to start if
# this is empty. Use a real generated secret in staging/production.
FLAGS_API_KEY=local-dev-only-change-me

# General HTTP throttling (milliseconds / request count)
THROTTLER_TTL=60000
THROTTLER_LIMIT=1000

# Optional Instana APM
ENABLE_METRICS=false
INSTANA_HOST=127.0.0.1
INSTANA_PORT=42699
INSTANA_LEVEL=info
INSTANA_SERVICE_NAME=feature-flag-api

# Optional NestJS logger levels: error,warn,log,debug,verbose,fatal
LOG_LEVEL=error,warn,log
